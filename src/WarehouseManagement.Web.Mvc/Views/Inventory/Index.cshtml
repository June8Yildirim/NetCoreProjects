@model IEnumerable<WarehouseManagement.Application.ViewModels.ListInventoryViewModel>
@{
  ViewData["Title"] = "Inventory";
}

<div class="text-center">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-extrabold text-3xl">Inventory</h1>
    <button onclick="openCreateModal()" class="btn btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24"
           stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Add Inventory
    </button>
  </div>
  <partial name="_InventoryList" model="Model" />
</div>

<!-- Modal Structure -->
<dialog id="create_inventory_modal" class="modal">
  <div class="modal-box max-w-2xl">
    <h3 id="modal-title" class="font-bold text-lg mb-4">Add New Inventory Item</h3>
    <div id="modal-content">
      <!-- Content will be loaded here -->
      <div class="flex justify-center py-8">
        <span class="loading loading-spinner loading-lg text-primary"></span>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

@section Scripts {
  <script>
    async function openCreateModal() {
      const modal = document.getElementById('create_inventory_modal');
      const title = document.getElementById('modal-title');

      title.innerText = "Add New Inventory Item";
      wms.showLoader('modal-content');
      modal.showModal();

      try {
        const html = await wms.request('@Url.Action("Create")');
        document.getElementById('modal-content').innerHTML = html;
        setupFormSubmission();
      } catch (error) {
        wms.showError('modal-content', error.message);
      }
    }

    async function switchToProductForm() {
      const title = document.getElementById('modal-title');
      title.innerText = "Quick Add New Product";
      wms.showLoader('modal-content', 'Loading product form...');

      try {
        const html = await wms.request('/Product/Create');
        document.getElementById('modal-content').innerHTML = html;
        setupProductFormSubmission();
      } catch (error) {
        wms.showError('modal-content', 'Failed to load the product form.');
      }
    }

    function handleProductCancel() {
      openCreateModal();
    }

    async function switchToEditInventoryForm(id) {
      const modal = document.getElementById('create_inventory_modal');
      const title = document.getElementById('modal-title');

      title.innerText = "Edit Inventory Item";
      wms.showLoader('modal-content', 'Preparing edit form...');

      if (!modal.open) {
        modal.showModal();
      }

      try {
        const html = await wms.request(`/Inventory/Edit/${id}`);
        document.getElementById('modal-content').innerHTML = html;
        setupFormSubmission();
      } catch (error) {
        wms.showError('modal-content', 'Failed to load the edit form.');
      }
    }

    function handleInventoryCancel() {
      document.getElementById('create_inventory_modal').close();
    }

    function setupProductFormSubmission() {
      const form = document.getElementById('createProductForm');
      if (!form) return;

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerText;

        try {
          submitBtn.disabled = true;
          submitBtn.innerText = 'Saving...';

          const data = await wms.request(form.action, {
            method: 'POST',
            body: formData
          });

          if (data.success) {
            openCreateModal();
          } else {
            document.getElementById('modal-content').innerHTML = data;
            setupProductFormSubmission();
          }
        } catch (error) {
          alert('Error saving product: ' + error.message);
          submitBtn.disabled = false;
          submitBtn.innerText = originalBtnText;
        }
      });
    }

    function setupFormSubmission() {
      const form = document.getElementById('createInventoryForm');
      if (!form) return;

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerText;

        try {
          submitBtn.disabled = true;
          submitBtn.innerText = 'Saving...';

          const data = await wms.request(form.action, {
            method: 'POST',
            body: formData
          });

          if (data.success) {
            location.reload(); 
          } else {
            document.getElementById('modal-content').innerHTML = data;
            setupFormSubmission();
          }
        } catch (error) {
          alert('Error saving inventory: ' + error.message);
          submitBtn.disabled = false;
          submitBtn.innerText = originalBtnText;
        }
      });
    }
  </script>
}
