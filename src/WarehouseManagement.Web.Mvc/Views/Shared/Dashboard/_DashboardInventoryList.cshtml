@model IEnumerable<WarehouseManagement.Application.ViewModels.ListInventoryViewModel>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
  @foreach (var inventory in Model)
  {
    <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
      <div class="card-body p-5">
        <div class="flex flex-col items-start gap-2 mb-2">
          <h3 class="font-bold text-xs leading-tight overflow-hidden text-ellipsis">@inventory.ProductName</h3>
          <h3 class="font-bold text-xs leading-tight overflow-hidden text-ellipsis">@inventory.WarehouseName</h3>

          <div class="flex flex-col gap-1">
            <div class="flex justify-between text-xs">
              <span class="text-secondary">Quantity Allocated:</span>
              <span class="font-bold">@inventory.QuantityAllocated</span>
            </div>
          </div>

          <div class="card-actions justify-between items-center mt-1">
            <button class="btn btn-secondary btn-xs btn-outline"
                    onclick="openInventoryModal('@inventory.Id')">Details</button>
          </div>
        </div>
      </div>
    </div>
  }
</div>
<!-- DaisyUI Modal -->
<dialog id="inventory_modal" class="modal">
  <div class="modal-box">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
    <h3 id="inventory_modal_title" class="font-bold text-lg mb-4">Inventory Details</h3>
    <div id="modal_content">
      <div class="flex flex-col items-center py-10">
        <span class="loading loading-spinner loading-lg text-primary"></span>
        <p class="mt-4 text-sm opacity-50">Loading details...</p>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  function openInventoryModal(id) {
    const modal = document.getElementById('inventory_modal');
    const content = document.getElementById('modal_content');
    const title = document.getElementById('inventory_modal_title');
    title.innerText = "Inventory Details"

    // Reset content to loader
    content.innerHTML = `
          <div class="flex flex-col items-center py-10">
            <span class="loading loading-spinner loading-lg text-primary"></span>
            <p class="mt-4 text-sm opacity-50">Loading details...</p>
          </div>
        `;

    modal.showModal();

    // Fetch details
    fetch(`/Inventory/GetDetailsPartial/${id}`)
      .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.text();
      })
      .then(html => {
        content.innerHTML = html;
      })
      .catch(error => {
        content.innerHTML = `
              <div class="alert alert-error">
                <span>Error loading details. Please try again.</span>
              </div>
            `;
        console.error('Error:', error);
      });
  }

  function switchToEditInventoryForm(id) {
    const modal = document.getElementById('inventory_modal');
    const content = document.getElementById('modal_content');
    const title = document.getElementById('inventory_modal_title');

    title.innerText = "Edit Inventory Item";
    content.innerHTML = '<div class="flex justify-center py-8"><span class="loading loading-spinner loading-lg text-primary"></span></div>';

    if (!modal.open) {
      modal.showModal();
    }

    fetch(`/Inventory/Edit/${id}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
      .then(r => r.text())
      .then(html => {
        content.innerHTML = html;
        setupFormSubmission();
      });
  }

  function handleInventoryCancel() {
    document.getElementById('inventory_modal').close();
  }

  function setupFormSubmission() {
    const form = document.getElementById('createInventoryForm');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const formData = new FormData(form);

      fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
        .then(response => {
          if (response.ok) return response.json().catch(() => response.text());
          throw new Error('Network response was not ok.');
        })
        .then(data => {
          if (data.success) {
            location.reload();
          } else {
            document.getElementById('modal_content').innerHTML = data;
            setupFormSubmission();
          }
        })
        .catch(error => console.error('Error:', error));
    });
  }
</script>
