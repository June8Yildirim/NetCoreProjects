@model IEnumerable<WarehouseManagement.Application.ViewModels.ListInventoryViewModel>

<div class="overflow-x-auto bg-base-100 rounded-xl shadow-xl border border-base-200">
  <table class="table table-zebra w-full">
    <thead>
      <tr class="bg-base-200 text-base-content/70">
        <th>Product</th>
        <th>Warehouse</th>
        <th>Stock</th>
        <th>Allocated</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var inventory in Model)
      {
        <tr class="hover">
          <td>
            <div>
              <div class="font-bold">@inventory.ProductName</div>
              <div class="text-[10px] opacity-50 font-mono">ID: @inventory.Id.ToString().Substring(0, 8)</div>
            </div>
          </td>
          <td>
            <div class="badge badge-ghost">@inventory.WarehouseName</div>
          </td>
          <td>
            <div class="flex flex-col">
              <span class="font-mono text-lg font-bold">@inventory.QuantityOnHand</span>
              <span class="text-[10px] opacity-50">Available: @inventory.AvailableQuantity</span>
            </div>
          </td>
          <td>
            <span class="text-sm opacity-70">@inventory.QuantityAllocated</span>
          </td>
          <td>
            <div class="badge @(inventory.NeedsReorder ? "badge-error" : "badge-success") badge-sm font-semibold">
              @(inventory.NeedsReorder ? "Needs Reorder" : "Healthy")
            </div>
            <progress
            class="progress @(inventory.NeedsReorder ? "progress-error" : "progress-success") w-20 block mt-1"
            value="@inventory.AvailableQuantity" max="100"></progress>
          </td>
          <td>
            <div class="flex gap-2">
              <button class="btn btn-primary btn-xs" onclick="openInventoryModal('@inventory.Id')">Details</button>
              <button class="btn btn-outline btn-xs" onclick="switchToEditInventoryForm('@inventory.Id')">Edit</button>
            </div>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

<!-- DaisyUI Modal -->
<dialog id="inventory_modal" class="modal">
  <div class="modal-box">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
    <div id="modal_content">
      <div class="flex flex-col items-center py-10">
        <span class="loading loading-spinner loading-lg text-primary"></span>
        <p class="mt-4 text-sm opacity-50">Loading details...</p>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  function openInventoryModal(id) {
    const modal = document.getElementById('inventory_modal');
    const content = document.getElementById('modal_content');

    // Reset content to loader
    content.innerHTML = `
      <div class="flex flex-col items-center py-10">
        <span class="loading loading-spinner loading-lg text-primary"></span>
        <p class="mt-4 text-sm opacity-50">Loading details...</p>
      </div>
    `;

    modal.showModal();

    // Fetch details
    fetch(`/Inventory/GetDetailsPartial/${id}`)
      .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.text();
      })
      .then(html => {
        content.innerHTML = html;
      })
      .catch(error => {
        content.innerHTML = `
          <div class="alert alert-error">
            <span>Error loading details. Please try again.</span>
          </div>
        `;
        console.error('Error:', error);
      });
  }

  function switchToEditInventoryForm(id) {
    // Determine which modal to use. Index.cshtml has create_inventory_modal.
    // Dashboard might have its own or share this one.
    const editModal = document.getElementById('create_inventory_modal') || document.getElementById('inventory_modal');
    const detailsModal = document.getElementById('inventory_modal');
    
    // If we have a separate edit modal (like on Index page), close details first
    if (editModal.id !== detailsModal.id && detailsModal.open) {
      detailsModal.close();
    }

    const content = editModal.id === 'create_inventory_modal' 
      ? document.getElementById('modal-content') 
      : document.getElementById('modal_content');
      
    const title = editModal.id === 'create_inventory_modal'
      ? document.getElementById('modal-title')
      : null; // inventory_modal might not have a separate title element yet

    if (title) title.innerText = "Edit Inventory Item";
    content.innerHTML = '<div class="flex justify-center py-8"><span class="loading loading-spinner loading-lg text-primary"></span></div>';

    if (!editModal.open) {
      editModal.showModal();
    }

    fetch(`/Inventory/Edit/${id}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
      .then(r => r.text())
      .then(html => {
        content.innerHTML = html;
        if (typeof setupFormSubmission === 'function') {
          setupFormSubmission();
        }
      });
  }

  function handleInventoryCancel() {
    const modal = document.getElementById('create_inventory_modal') || document.getElementById('inventory_modal');
    modal.close();
  }
</script>
