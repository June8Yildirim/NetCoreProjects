@model WarehouseManagement.Application.ViewModels.Product.Create.CreateProductViewModel

<form asp-action="Create" method="post" id="createProductForm" class="space-y-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="form-control w-full">
            <label asp-for="Name" class="label">
                <span class="label-text font-bold">Product Name</span>
            </label>
            <input asp-for="Name" class="input input-bordered w-full" placeholder="e.g. Widget A" />
            <span asp-validation-for="Name" class="text-error text-sm mt-1"></span>
        </div>

        <div class="form-control w-full">
            <label asp-for="SKU" class="label">
                <span class="label-text font-bold">SKU</span>
            </label>
            <input asp-for="SKU" class="input input-bordered w-full" placeholder="e.g. WDG-001" />
            <span asp-validation-for="SKU" class="text-error text-sm mt-1"></span>
        </div>

        <div class="form-control w-full">
            <label asp-for="SupplierId" class="label">
                <span class="label-text font-bold">Supplier</span>
            </label>
            <select asp-for="SupplierId" asp-items="Model.Suppliers" class="select select-bordered w-full">
                <option disabled selected>-- Select Supplier --</option>
            </select>
            <span asp-validation-for="SupplierId" class="text-error text-sm mt-1"></span>
        </div>

        <div class="form-control w-full">
            <label asp-for="ReorderLevel" class="label">
                <span class="label-text font-bold">Reorder Level</span>
            </label>
            <input asp-for="ReorderLevel" type="number" class="input input-bordered w-full" placeholder="e.g. 50" />
            <span asp-validation-for="ReorderLevel" class="text-error text-sm mt-1"></span>
        </div>

        <div class="form-control w-full">
            <label asp-for="UnitCost" class="label">
                <span class="label-text font-bold">Unit Cost ($)</span>
            </label>
            <input asp-for="UnitCost" type="number" step="0.01" class="input input-bordered w-full" placeholder="e.g. 19.99" />
            <span asp-validation-for="UnitCost" class="text-error text-sm mt-1"></span>
        </div>

        <div class="form-control w-full">
            <label asp-for="WeightLbs" class="label">
                <span class="label-text font-bold">Weight (Lbs)</span>
            </label>
            <input asp-for="WeightLbs" type="number" step="0.01" class="input input-bordered w-full" placeholder="e.g. 1.5" />
            <span asp-validation-for="WeightLbs" class="text-error text-sm mt-1"></span>
        </div>

        <div class="form-control w-full">
            <label asp-for="Category" class="label">
                <span class="label-text font-bold">Category</span>
            </label>
            <input asp-for="Category" class="input input-bordered w-full" placeholder="e.g. Electronics" />
            <span asp-validation-for="Category" class="text-error text-sm mt-1"></span>
        </div>

        <div class="form-control w-full">
            <label asp-for="Barcode" class="label">
                <span class="label-text font-bold">Barcode</span>
            </label>
            <input asp-for="Barcode" class="input input-bordered w-full" placeholder="e.g. 123456789012" />
            <span asp-validation-for="Barcode" class="text-error text-sm mt-1"></span>
        </div>
    </div>

    <div class="modal-action mt-6">
        <button type="button" onclick="create_product_modal.close()" class="btn btn-ghost">Cancel</button>
        <button type="submit" class="btn btn-primary px-8">Save Product</button>
    </div>
</form>