@model IEnumerable<WarehouseManagement.Application.ViewModels.ListProductViewModel>

<div class="overflow-x-auto bg-base-100 rounded-xl shadow-xl border border-base-200">
  <table class="table table-zebra w-full">
    <thead>
      <tr class="bg-base-200 text-base-content/70">
        <th>Product</th>
        <th>Category</th>
        <th>Supplier Name</th>
        <th>SKU</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var product in Model)
      {

        <tr class="hover">
          <td>
            <div>
              <div class="font-bold">@product.Name</div>
              <div class="text-[10px] opacity-50 font-mono">ID: @product.Id.ToString().Substring(0, 8)</div>
            </div>
          </td>
          <td>
            <div class="badge badge-ghost">@product.Category </div>
          </td>
          <td>
            <span class="font-mono text-xs font-thin ">@product.SupplierName</span>
          </td>
          <td>
            <span class="text-sm opacity-70">@product.SKU</span>
          </td>
          <td>
            <div class="badge @product.ReorderLevel badge-sm font-semibold">
              @(product.ReorderLevel > 10 ? "Valet" : (product.ReorderLevel > 50 ? "King" : "Queen"))
            </div>
            <progress
            class="progress @( product.ReorderLevel > 10 ? "progress-error" : "progress-success") w-20 block mt-1"
            max="100" value="@product.UnitCost"></progress>
          </td>
          <td>
            <div class="flex gap-2">
              <button class="btn btn-primary btn-xs" onclick="openProductModal('@product.Id')">Details</button>
            </div>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
