@model IEnumerable<WarehouseManagement.Application.ViewModels.ListProductViewModel>

<div class="overflow-x-auto bg-base-100 rounded-xl shadow-xl border border-base-200">
  <table class="table table-zebra w-full">
    <thead>
      <tr class="bg-base-200 text-base-content/70">
        <th>Product</th>
        <th>Category</th>
        <th>Supplier Name</th>
        <th>SKU</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var product in Model)
      {

        <tr class="hover">
          <td>
            <div>
              <div class="font-bold">@product.Name</div>
              <div class="text-[10px] opacity-50 font-mono">ID: @product.Id.ToString().Substring(0, 8)</div>
            </div>
          </td>
          <td>
            <div class="badge badge-ghost">@product.Category </div>
          </td>
          <td>
            <span class="font-mono text-xs font-thin ">@product.SupplierName</span>
          </td>
          <td>
            <span class="text-sm opacity-70">@product.SKU</span>
          </td>
          <td>
            <div class="badge @product.ReorderLevel badge-sm font-semibold">
              @(product.ReorderLevel > 10 ? "Valet" : (product.ReorderLevel > 50 ? "King" : "Queen"))
            </div>
            <progress
            class="progress @( product.ReorderLevel > 10 ? "progress-error" : "progress-success") w-20 block mt-1"
            max="100" value="@product.UnitCost"></progress>
          </td>
          <td>
            <div class="flex gap-2">
              <button class="btn btn-primary btn-xs" onclick="openProductModal('@product.Id')">Details</button>
            </div>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>


<!-- Unique ID for Product Modal -->
<dialog id="product_modal" class="modal">
  <div class="modal-box">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
    <div id="product_modal_content">
      <div class="flex flex-col items-center py-10">
        <span class="loading loading-spinner loading-lg text-secondary"></span>
        <p class="mt-4 text-sm opacity-50">Loading product details...</p>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  function openProductModal(id) {
    const modal = document.getElementById('product_modal');
    const content = document.getElementById('product_modal_content');

    content.innerHTML = `
      <div class="flex flex-col items-center py-10">
        <span class="loading loading-spinner loading-lg text-secondary"></span>
        <p class="mt-4 text-sm opacity-50">Loading product details...</p>
      </div>
    `;

    modal.showModal();

    // Correct route: /Product/ProductDetails/
    fetch(`/Product/ProductDetails/${id}`)
      .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.text();
      })
      .then(html => {
        content.innerHTML = html;
      })
      .catch(error => {
        content.innerHTML = `
          <div class="alert alert-error">
            <span>Error loading product. Please try again.</span>
          </div>
        `;
        console.error('Error:', error);
      });
  }
</script>
