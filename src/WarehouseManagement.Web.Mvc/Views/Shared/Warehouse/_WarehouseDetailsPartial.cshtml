@model WarehouseManagement.Application.ViewModels.WarehouseDetailsViewModel

<div class="space-y-6">
  <div class="bg-base-200 p-4 rounded-lg">
    <h2 class="text-2xl font-bold text-primary">@Model.Name</h2>
    <div class="badge badge-outline badge-sm mt-1">@Model.Name</div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="bg-base-200 p-4 rounded-lg">
      <div class="text-xs opacity-60 uppercase font-bold">Warehouse Code</div>
      <div class="text-3xl font-black">@Model.WarehouseCode</div>
    </div>
    <div class="bg-base-200 p-4 rounded-lg">
      <div class="text-xs opacity-60 uppercase font-bold">Timezone</div>
      <div class="text-3xl font-black">@Model.Timezone</div>
    </div>
    <div class="bg-base-200 p-4 rounded-lg">
      <div class="text-xs opacity-60 uppercase font-bold">Capacity Square Feet</div>
      <div class="text-3xl font-black">@Model.CapacitySquareFeet</div>
    </div>
    <div class="bg-base-200 p-4 rounded-lg">
      <div class="text-xs opacity-60 uppercase font-bold">Inventories Count</div>
      <div class="text-3xl font-black">@Model.Inventories.Count</div>
    </div>
  </div>

  <div class="divider m-0"></div>

  <div class="space-y-3">
    <div class="flex justify-between text-sm">
      <span class="opacity-60">Employee Count:</span>
      <span class="font-mono">@Model.Users.Count</span>
    </div>
    <div class="flex justify-between text-sm">
      <span class="opacity-60">From Transfers:</span>
      <span class="font-mono">@Model.FromTransfers.Count</span>
    </div>
    <div class="flex justify-between text-sm">
      <span class="opacity-60">To Transfers:</span>
      <span class="font-mono">@Model.ToTransfers.Count</span>
    </div>
  </div>

  <div class="modal-action">
    <button class="btn btn-outline btn-sm" onclick="switchToEditWarehouseForm('@Model.Id')">Edit</button>
    <button class="btn btn-primary btn-sm" onclick="document.getElementById('warehouse_modal').close()">Close</button>
  </div>
</div>
