@using WarehouseManagement.Models
@model IEnumerable<WarehouseManagement.Application.ViewModels.ListWarehouseViewModel>

<div class="overflow-x-auto bg-base-100 rounded-xl shadow-xl border border-base-200">
  <table class="table table-zebra w-full">
    <thead>
      <tr class="bg-base-200 text-base-content/70">
        <th>Warehouse</th>
        <th>Warehouse Code</th>
        <th>Capacity Square Feet</th>
        <th>From Transfers</th>
        <th>To Transfers</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var warehouse in Model)
      {

        <tr class="hover">
          <td>
            <div>
              <div class="font-bold">@warehouse.Name</div>
              <div class="text-[10px] opacity-50 font-mono">ID: @warehouse.Id.ToString().Substring(0, 8)</div>
            </div>
          </td>
          <td>
            <div class="badge badge-ghost">@warehouse.WarehouseCode</div>
          </td>
          <td>
            <span class="font-mono text-xs font-thin ">@warehouse.CapacitySquareFeet</span>
          </td>
          <td>
            <span class="text-sm opacity-70">@warehouse.TotalInventories</span>
          </td>
          <td>
            <div class="badge @(warehouse.FromTransfers?.Count ?? 0) badge-sm font-semibold">
              @((warehouse.ToTransfers?.Count ?? 0) > 10 ? "Valet" : ((warehouse.FromTransfers?.Count ?? 0) > 50 ? "King" : "Queen"))
            </div>
            <progress
            class="progress @((warehouse.FromTransfers?.Count ?? 0) > 10 ? "progress-error" : "progress-success") w-20 block mt-1"
            max="100" value="@(warehouse.FromTransfers?.Count ?? 0)"></progress>
          </td>
          <td>
            <div class="flex gap-2">
              <button class="btn btn-primary btn-xs" onclick="openWarehouseModal('@warehouse.Id')">Details</button>
            </div>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

<!-- Unique ID for Warehouse Modal -->
<dialog id="warehouse_modal" class="modal">
  <div class="modal-box">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
    <div id="warehouse_modal_content">
      <div class="flex flex-col items-center py-10">
        <span class="loading loading-spinner loading-lg text-primary"></span>
        <p class="mt-4 text-sm opacity-50">Loading warehouse details...</p>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  function openWarehouseModal(id) {
    const modal = document.getElementById('warehouse_modal');
    const content = document.getElementById('warehouse_modal_content');

    content.innerHTML = `
      <div class="flex flex-col items-center py-10">
        <span class="loading loading-spinner loading-lg text-primary"></span>
        <p class="mt-4 text-sm opacity-50">Loading warehouse details...</p>
      </div>
    `;

    modal.showModal();

    // Correct route: /Warehouse/WarehouseDetails/
    fetch(`/Warehouse/WarehouseDetails/${id}`)
      .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.text();
      })
      .then(html => {
        content.innerHTML = html;
      })
      .catch(error => {
        content.innerHTML = `
          <div class="alert alert-error">
            <span>Error loading warehouse. Please try again.</span>
          </div>
        `;
        console.error('Error:', error);
      });
  }
</script>
