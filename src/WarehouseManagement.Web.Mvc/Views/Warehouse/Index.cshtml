@model IEnumerable<WarehouseManagement.Application.ViewModels.ListWarehouseViewModel>
@{
  ViewData["Title"] = "Warehouse";
}

<div class="text-center">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-extrabold text-3xl">Warehouses</h1>
    <button onclick="openCreateModal()" class="btn btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24"
           stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Add Warehouse
    </button>
  </div>
  <partial name="_WarehouseList" model="Model" />
</div>

<!-- Unified Modal Structure -->
<dialog id="warehouse_modal" class="modal">
  <div class="modal-box max-w-3xl">
    <h3 id="warehouse_modal_title" class="font-bold text-lg mb-4">Warehouse Details</h3>
    <div id="warehouse_modal_content">
      <!-- Content will be loaded here -->
      <div class="flex justify-center py-8">
        <span class="loading loading-spinner loading-lg text-primary"></span>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

@section Scripts {
  <script>
    async function openCreateModal() {
      const modal = document.getElementById('warehouse_modal');
      const title = document.getElementById('warehouse_modal_title');

      title.innerText = "Add New Warehouse";
      wms.showLoader('warehouse_modal_content');
      modal.showModal();

      try {
        const html = await wms.request('@Url.Action("Create")');
        document.getElementById('warehouse_modal_content').innerHTML = html;
        setupFormSubmission();
      } catch (error) {
        wms.showError('warehouse_modal_content', 'Failed to load create form.');
      }
    }

    async function openWarehouseModal(id) {
        const modal = document.getElementById('warehouse_modal');
        const title = document.getElementById('warehouse_modal_title');

        title.innerText = "Warehouse Details";
        wms.showLoader('warehouse_modal_content');
        modal.showModal();

        try {
          const html = await wms.request(`/Warehouse/WarehouseDetails/${id}`);
          document.getElementById('warehouse_modal_content').innerHTML = html;
        } catch (error) {
          wms.showError('warehouse_modal_content', 'Failed to load warehouse details.');
        }
    }

    async function switchToEditWarehouseForm(id) {
      const modal = document.getElementById('warehouse_modal');
      const title = document.getElementById('warehouse_modal_title');
      
      title.innerText = "Edit Warehouse";
      wms.showLoader('warehouse_modal_content', 'Preparing edit form...');

      if (!modal.open) {
        modal.showModal();
      }

      try {
        const html = await wms.request(`/Warehouse/Edit/${id}`);
        document.getElementById('warehouse_modal_content').innerHTML = html;
        setupFormSubmission();
      } catch (error) {
        wms.showError('warehouse_modal_content', 'Failed to load the edit form.');
      }
    }

    function handleWarehouseCancel() {
      document.getElementById('warehouse_modal').close();
    }

    function setupFormSubmission() {
      const form = document.getElementById('createWarehouseForm');
      if (!form) return;

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerText;

        try {
          submitBtn.disabled = true;
          submitBtn.innerText = 'Saving...';

          const data = await wms.request(form.action, {
            method: 'POST',
            body: formData
          });

          if (data.success) {
            location.reload(); 
          } else {
            document.getElementById('warehouse_modal_content').innerHTML = data;
            setupFormSubmission(); 
          }
        } catch (error) {
          alert('Error saving warehouse: ' + error.message);
          submitBtn.disabled = false;
          submitBtn.innerText = originalBtnText;
        }
      });
    }
  </script>
}
